/** Thin offline capture around existing production retrieval; no new ranking or scoring. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import path from 'node:path';
import {semanticRetrieve,lexicalRanking,embedLocally,cosineSimilarity,disposeEmbeddingModel,indexFile,embeddingModel,embeddingRevision,corpusFingerprint,localEvidenceScoreFloor} from '../../src/lib/semantic';
import {evidenceSources,lookupAdditive,lookupExplicitAdditiveMention} from '../../src/modules/knowledge/index';
import {executeGeminiTool} from '../../src/lib/server/gemini-tools';
import {defaultProfile} from '../../src/lib/contracts';
const out=path.resolve(process.argv[2]);if(!process.argv[2])throw Error('Private output directory required');await mkdir(out,{recursive:false});
const network:any[]=[];globalThis.fetch=async(input:any)=>{network.push({destination:new URL(typeof input==='string'?input:input.url).origin,allowed:false});throw Error('Offline assessment: external requests prohibited');};
const load=async(p:string)=>JSON.parse((await readFile(p,'utf8')).replace(/^\uFEFF/,''));const hash=(x:string)=>createHash('sha256').update(x).digest('hex');
const manifest=await load('data/evaluation/benchmark-retrieval-queries-v1.json');const boundaries=await load('data/semantic-boundary-queries.json');const index=await load(indexFile);const rows:any[]=[];
const catalog=new Map(evidenceSources.map(s=>[s.id,s]));
try {for(const item of [...manifest.queries.map((q:any)=>({...q,suite:'frozen-24'})),...boundaries.map((q:any)=>({queryId:q.id,query:q.query,suite:'developer-boundary',declaredExpectedIds:q.relevant,judgments:{},applicability:{},judgmentStatus:'unjudged',poolComplete:false,k:5}))]){
 const started=performance.now();const query=item.query;const timings:any={};const context={question:query,package:{id:'retrieval-empty-context',name:'No package',ingredients:[],additives:[],allergens:[],claims:[],nutrients:[],observations:[],rawText:'',warnings:[],synthetic:true,createdAt:'2026-10-30T00:00:00.000Z'},profile:defaultProfile,visualImages:[],searchTerms:new Set<string>(),prepareImage:async(image:any)=>image.base64};
 let t=performance.now();const guidance=await executeGeminiTool('get_nutrition_guidance',{query,maxResults:5},context);const identity=lookupAdditive(query)??lookupExplicitAdditiveMention(query);const structured=[...new Set([...(guidance.evidence??[]).map(s=>s.id),...(identity?.sourceIds??[])])];timings.structuredMs=performance.now()-t;
 t=performance.now();const lexical=lexicalRanking(query);timings.lexicalMs=performance.now()-t;
 let semantic:any=null,hybrid:any=null,application:any=null,error:any=null;
 try{t=performance.now();const [v]=await embedLocally([query]);semantic=index.vectors.map((r:any)=>({id:r.id,score:cosineSimilarity(v,r.vector)})).sort((a:any,b:any)=>b.score-a.score);timings.semanticMs=performance.now()-t;t=performance.now();hybrid=await semanticRetrieve(query,5);timings.hybridMs=performance.now()-t;t=performance.now();application=await executeGeminiTool('search_knowledge',{query},context);timings.applicationFilteredMs=performance.now()-t;}catch(e:any){error={name:e.name,message:String(e.message).slice(0,200)};}
 const sources=(ids:string[])=>ids.map(id=>catalog.get(id)??guidance.evidence?.find(s=>s.id===id)??{id,catalogMissing:true});
 const modes={structured:{rankedIds:structured.slice(0,5),details:guidance,identity:identity??null},lexical:{rankedIds:lexical.filter(x=>x.lexicalScore>0).slice(0,5).map(x=>x.source.id),rawRanking:lexical.map(x=>({id:x.source.id,score:x.lexicalScore})),abstention:'Only positive BM25 scores; no independently calibrated relevance threshold'},semantic:{rankedIds:semantic?.slice(0,5).map((x:any)=>x.id)??[],rawRanking:semantic,available:semantic!==null,abstention:'Unthresholded cosine baseline; not the application policy'},hybrid:{rankedIds:hybrid?.results.map((x:any)=>x.source.id)??[],details:hybrid,available:hybrid!==null},application:{rankedIds:application?.evidence?.map((x:any)=>x.id)??[],details:application}};
 rows.push({...item,developerSuggestedPoolOnly:undefined,modes,timings,totalMs:performance.now()-started,error,sourceRecords:Object.fromEntries(Object.entries(modes).map(([name,m]:any)=>[name,sources(m.rankedIds)])),judgmentScope:'No independent qrels. Source identity/similarity is not applicability or entailment.'});
 console.log(JSON.stringify({id:item.queryId,suite:item.suite,counts:Object.fromEntries(Object.entries(modes).map(([k,v]:any)=>[k,v.rankedIds.length])),error}));
 }}finally{await disposeEmbeddingModel();}
const result={at:new Date().toISOString(),implementationCommit:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),queryManifestSha256:hash(await readFile('data/evaluation/benchmark-retrieval-queries-v1.json','utf8')),sourceSnapshotSha256:corpusFingerprint(),corpusDocuments:evidenceSources.length,embeddingModel,embeddingRevision,localEvidenceScoreFloor,rows,network,limitations:['No independent relevance/applicability judgments','Developer boundary expectations are diagnostic only','Structured lookup returns eligible guidance/exact identities, not a universal ranked-search baseline','Cold first embedding initialization and warm later queries retained','The application tool applies additional topical/scope filtering after hybrid ranking']};
await writeFile(path.join(out,'retrieval-capture.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});
for(const mode of ['structured','lexical','semantic','hybrid','application'])await writeFile(path.join(out,mode+'-metric-input.json'),JSON.stringify(rows.filter(x=>x.suite==='frozen-24').map(x=>({queryId:x.queryId,k:x.k,rankedIds:x.modes[mode].rankedIds,judgments:x.judgments,applicability:x.applicability,judgmentStatus:x.judgmentStatus,poolComplete:x.poolComplete})),null,2)+'\n',{flag:'wx'});
