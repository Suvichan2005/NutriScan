/** Offline capture for existing experiment adapters; no provider invocation permitted. */
import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';
const prepared=process.argv[2];if(!prepared)throw Error('Usage: node --import tsx capture_benchmark_contracts.mts <prepared-directory>');
const output=path.join(prepared,process.argv[3]??'contracts');fs.mkdirSync(output,{recursive:false});let networkAttempts=0;
globalThis.fetch=(async()=>{networkAttempts++;throw Error('Network disabled in benchmark preparation');}) as typeof fetch;
for(const key of ['GEMINI_API_KEY','FREE_GEMINI_API_KEY','GOOGLE_API_KEY'])delete process.env[key];process.env.ENABLE_GEMINI='false';process.env.ENABLE_PAID_GEMINI='false';
const {getAgentSystemInstruction,getAgentToolDeclarations,getPackageReconstructionSystemInstruction}=await import('../../src/lib/server/gemini.ts');const {defaultProfile,profileSchema,packageSchema}=await import('../../src/lib/contracts.ts');const {evidenceSources,corpusVersion}=await import('../../src/lib/knowledge.ts');
const sha=(v:string)=>crypto.createHash('sha256').update(v).digest('hex');const write=(name:string,v:unknown)=>fs.writeFileSync(path.join(output,name),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const on=getAgentToolDeclarations(false,false),off=getAgentToolDeclarations(false,false,{mode:'research',names:['calculate_nutrition','clarify_package_reading']});
write('tools.json',{knowledgeOn:on,knowledgeOff:off,knowledgeOnSha256:sha(JSON.stringify(on)),knowledgeOffSha256:sha(JSON.stringify(off)),ordinaryWithImagesCount:getAgentToolDeclarations(true,false).length,ordinaryTextCount:on.length,policy:'Only tool availability differs; no external evidence/history injected into initial paired context. Model/config/base prompt must match at future execution freeze.'});
write('instructions.json',{agent:getAgentSystemInstruction(),reconstruction:getPackageReconstructionSystemInstruction(),agentSha256:sha(getAgentSystemInstruction()),reconstructionSha256:sha(getPackageReconstructionSystemInstruction())});
write('source-catalog.json',{corpusVersion,scope:'curated source summaries and metadata, not complete rich stores or independently judged applicability',sources:evidenceSources});
const canonical=JSON.parse(fs.readFileSync(path.join(prepared,'canonical-conversations.json'),'utf8'));const pairs=[];
for(const c of canonical.conversations){const turn=c.turns[0];const profile=profileSchema.parse({...defaultProfile,dietaryPattern:canonical.commonContext.suggestionsInTheseTests,healthConsiderations:canonical.profiles[c.profileCode].join('; ')});const snapshot=fs.readFileSync(path.join(prepared,'conversation-contexts',c.id[0]+'-snapshot.json'));packageSchema.parse(JSON.parse(snapshot.toString('utf8').replace(/^\uFEFF/,'')));
const shared={question:turn.userText,questionSha256:turn.sourceTextSha256,profile,profileNature:'fictional',packageSnapshotSha256:sha(snapshot.toString('utf8')),referenceGrade:3,evidence:[],calculations:[],conversationContext:[],visualImages:[]};pairs.push({conversationId:c.id,turn:1,sharedContext:shared,contextSha256:sha(JSON.stringify(shared)),treatments:[{id:'knowledge-on',toolAccess:{mode:'research',names:on.map(t=>t.name)},toolManifestSha256:sha(JSON.stringify(on))},{id:'knowledge-off',toolAccess:{mode:'research',names:off.map(t=>t.name)},toolManifestSha256:sha(JSON.stringify(off))}],status:'PREPARED_NOT_EXECUTED_PACKAGE_REFERENCE_AND_EXECUTION_FREEZE_PENDING'});}
write('knowledge-pairs.json',{pairs,logicalPairCount:pairs.length,execution:false,networkAttempts,modelCalls:0});console.log(JSON.stringify({pairs:pairs.length,sourceCatalogRecords:evidenceSources.length,ordinaryTextTools:on.length,knowledgeOffTools:off.length,networkAttempts}));
