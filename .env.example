# Gemini credentials remain server-side. GEMINI_PROVIDER selects exactly one project.
# Current stable default candidate for free-tier multimodal extraction (checked 2026-10-22): gemini-3.8-flash.
# Gemini 4 Argon is newer and more capable for hard reasoning, but is paid-only; do not select it without owner-approved spend and evaluation.
FREE_GEMINI_API_KEY=
GEMINI_API_KEY=
GEMINI_PROVIDER=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_GEMINI=false
ENABLE_PAID_GEMINI=false
# Paid calls stay blocked unless every positive cap and current price below is configured.
GEMINI_PAID_BUDGET_USD=0
GEMINI_PAID_MAX_CALLS=0
GEMINI_PAID_MAX_INPUT_TOKENS=0
GEMINI_PAID_MAX_OUTPUT_TOKENS=0
GEMINI_PAID_INPUT_USD_PER_MILLION=0
GEMINI_PAID_OUTPUT_USD_PER_MILLION=0
ENABLE_GEMINI_SEARCH=false
NUTRISCAN_CONTACT=
