# Gemini credentials remain server-side. Free is the default; it uses only FREE_GEMINI_API_KEY.
# The free router tries these models in order and learns per-model availability from actual API responses.
FREE_GEMINI_API_KEY=
# Paid-project key (legacy variable name); used only for explicit paid mode or enabled last-resort fallback.
GEMINI_API_KEY=
# Optional non-secret Google Cloud project IDs. Required and distinct before paid fallback can be enabled.
GEMINI_FREE_PROJECT_ID=
GEMINI_PAID_PROJECT_ID=
GEMINI_PROVIDER=free
GEMINI_FREE_MODEL_ORDER=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
ENABLE_GEMINI=false
ENABLE_PAID_GEMINI=false
ENABLE_PAID_GEMINI_FALLBACK=false
# Paid calls stay blocked unless every positive cap and current price below is configured.
GEMINI_PAID_BUDGET_USD=0
GEMINI_PAID_MAX_CALLS=0
GEMINI_PAID_MAX_INPUT_TOKENS=0
GEMINI_PAID_MAX_OUTPUT_TOKENS=0
GEMINI_PAID_INPUT_USD_PER_MILLION=0
GEMINI_PAID_CACHED_INPUT_USD_PER_MILLION=0
GEMINI_PAID_OUTPUT_USD_PER_MILLION=0
GEMINI_USD_TO_INR_ASSUMPTION=0
# Optional local-development telemetry: stage/model/usage metadata only.
# Request bodies, model text, images, health/profile data and tool arguments are omitted.
# Both flags must be explicitly set to 1; keep disabled by default.
NUTRISCAN_GEMINI_TRACE=0
NUTRISCAN_LOCAL_DEV_ONLY=0
# Explicit local-only readable evaluation capture. Leave off for ordinary use.
# When enabled in a development process, records sanitized prompts/OCR, provider
# outputs, tool results and validation decisions under ignored .data/ storage.
# Use only for authorized fixture images and fictional profile context; image
# bytes, credentials and hidden model reasoning are always excluded.
NUTRISCAN_GEMINI_EVAL_CAPTURE=0
# Extra opt-in required before any explicitly synthetic profile fields are kept.
NUTRISCAN_GEMINI_EVAL_ALLOW_SYNTHETIC_PROFILE=0
ENABLE_GEMINI_SEARCH=false
NUTRISCAN_CONTACT=
