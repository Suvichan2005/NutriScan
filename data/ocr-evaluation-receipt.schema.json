{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutriscan:ocr-evaluation-receipt:2",
  "title": "NutriScan OCR evaluation receipt",
  "description": "Sanitized common per-image result contract. It retains normalized candidate values and per-field stage outcomes but no image bytes or raw OCR text.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "experimentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "runAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held-out",
        "not-assigned"
      ]
    },
    "referenceStatus": {
      "type": "string",
      "enum": [
        "human-verified",
        "model-assisted",
        "single-reader"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "productGroupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "preprocessing": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "imageId",
        "productGroupId",
        "sha256",
        "width",
        "height",
        "preprocessing"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "mode": {
          "type": "string",
          "enum": [
            "browser",
            "local",
            "server",
            "remote",
            "hybrid"
          ]
        },
        "codeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "configuration": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^(?!.*(?:api[-_]?key|auth|credential|cookie|access[-_]?token|secret|password|prompt|raw[-_]?(?:text|ocr)|recognized[-_]?text|image[-_]?(?:bytes|data)|request[-_]?body|conversation)).*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "model": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "artifactUrls": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "artifactSha256": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  }
                },
                "licenseId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "licenseUrl": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sizeBytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "version",
                "artifactUrls",
                "artifactSha256",
                "licenseId",
                "licenseUrl",
                "sizeBytes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "mode",
        "codeRevision",
        "configuration",
        "model"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "runtime": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "browser": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "operatingSystem": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "deviceClass": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "threadCount": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "networkProfile": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheState": {
          "type": "string",
          "enum": [
            "cold",
            "warm",
            "mixed",
            "unknown"
          ]
        },
        "powerProfile": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "thermalState": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runtime",
        "browser",
        "operatingSystem",
        "architecture",
        "cpu",
        "gpu",
        "deviceClass",
        "threadCount",
        "networkProfile",
        "cacheState",
        "powerProfile",
        "thermalState"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "coldStartMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "inferenceMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "warmRunCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "warmMedianMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "warmP95Ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "networkBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "imageTransferBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "modelBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "type": "object",
          "properties": {
            "valueBytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "browser-js-heap",
                "browser-process-rss",
                "wasm-linear-memory",
                "process-rss",
                "unavailable"
              ]
            },
            "measurement": {
              "type": "string",
              "enum": [
                "peak",
                "sample",
                "unavailable"
              ]
            }
          },
          "required": [
            "valueBytes",
            "scope",
            "measurement"
          ],
          "additionalProperties": false
        },
        "estimatedCostPer1000Images": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "costCurrency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "costAssumptions": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "costSourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "costAssumptionDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fieldScoring": {
          "type": "object",
          "properties": {
            "expected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedClear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "emitted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scoredEmitted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "matched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "exact": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "incorrect": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "omitted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "abstained": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unscorable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unscorableEmitted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "falsePositives": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "exactFieldPrecision": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "exactFieldRecall": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "fieldCoverage": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "numericCorrect": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "numericScored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "numericAccuracy": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "unitCorrect": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unitScored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unitAccuracy": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "basisCorrect": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "basisScored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "basisAccuracy": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "expected",
            "expectedClear",
            "emitted",
            "scoredEmitted",
            "matched",
            "exact",
            "incorrect",
            "omitted",
            "abstained",
            "unscorable",
            "unscorableEmitted",
            "falsePositives",
            "exactFieldPrecision",
            "exactFieldRecall",
            "fieldCoverage",
            "numericCorrect",
            "numericScored",
            "numericAccuracy",
            "unitCorrect",
            "unitScored",
            "unitAccuracy",
            "basisCorrect",
            "basisScored",
            "basisAccuracy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "coldStartMs",
        "inferenceMs",
        "warmRunCount",
        "warmMedianMs",
        "warmP95Ms",
        "networkBytes",
        "imageTransferBytes",
        "modelBytes",
        "memory",
        "estimatedCostPer1000Images",
        "costCurrency",
        "costAssumptions",
        "costSourceUrl",
        "costAssumptionDate",
        "fieldScoring"
      ],
      "additionalProperties": false
    },
    "fields": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
