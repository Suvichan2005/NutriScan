                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "key",
                  "numericValue",
                  "numericOperator",
                  "unit",
                  "basis"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "exact",
              "incorrect",
              "omitted",
              "abstained",
              "unscorable",
              "false-positive"
            ]
          },
          "numericExact": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "unitExact": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "basisExact": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "stage": {
            "type": "object",
            "properties": {
              "textRegionDetected": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "labelRecognized": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "valueRecognized": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "rowColumnAssociated": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "unitRecognized": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "basisRecognized": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "parserAccepted": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "textRegionDetected",
              "labelRecognized",
              "valueRecognized",
              "rowColumnAssociated",
              "unitRecognized",
              "basisRecognized",
              "parserAccepted"
