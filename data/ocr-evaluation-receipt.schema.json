        "required": [
          "fieldId",
          "candidateId",
          "emitted",
          "outcome",
          "numericExact",
          "unitExact",
          "basisExact",
          "stage",
          "parserRejectionCode"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "experimentId",
    "datasetVersion",
    "runAt",
    "split",
    "referenceStatus",
    "input",
    "engine",
    "environment",
    "metrics",
    "fields"
  ],
  "additionalProperties": false
}
