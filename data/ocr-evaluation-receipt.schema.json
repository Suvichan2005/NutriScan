                              "per-package",
                              "per-unit",
                              "other",
                              "unknown"
                            ]
                          },
                          "amount": {
                            "anyOf": [
                              {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 10000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "unit": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "g",
                                  "ml",
                                  "piece"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "amount",
                          "unit"
                        ],
                        "additionalProperties": false
