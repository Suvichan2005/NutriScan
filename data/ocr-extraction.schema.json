{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutriscan:ocr-extraction:1",
  "title": "NutriScan transient OCR extraction",
  "description": "Common in-memory output contract for browser, local, server, remote, and hybrid OCR adapters. Recognized text is transient and must not be persisted in tracked receipts.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "input": {
      "type": "object",
      "properties": {
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "productGroupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "imageId",
        "sha256",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "mode": {
          "type": "string",
          "enum": [
            "browser",
            "local",
            "server",
            "remote",
            "hybrid"
          ]
        },
        "codeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "configuration": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^(?!.*(?:api[-_]?key|auth|credential|cookie|access[-_]?token|secret|password|prompt|raw[-_]?(?:text|ocr)|recognized[-_]?text|image[-_]?(?:bytes|data)|request[-_]?body|conversation)).*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "model": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "artifactUrls": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "artifactSha256": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  }
                },
                "licenseId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "licenseUrl": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sizeBytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "version",
                "artifactUrls",
                "artifactSha256",
                "licenseId",
                "licenseUrl",
                "sizeBytes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "mode",
        "codeRevision",
        "configuration",
        "model"
      ],
      "additionalProperties": false
    },
    "recognizedRegions": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "table",
              "row",
              "label",
              "value",
              "unit",
              "basis",
              "other-text"
            ]
          },
          "polygon": {
            "minItems": 4,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "regionId",
          "role",
          "polygon",
          "confidence",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "candidates": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "numericValue": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "numericOperator": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "eq",
                  "lt",
                  "lte",
                  "gt",
                  "gte"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "per-100g",
                      "per-100ml",
                      "per-serving",
                      "per-package",
                      "per-unit",
                      "other",
                      "unknown"
                    ]
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "g",
                          "ml",
                          "piece"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "amount",
                  "unit"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceRegionIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "candidateId",
          "key",
          "numericValue",
          "numericOperator",
          "unit",
          "basis",
          "sourceRegionIds",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "abstentions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "basis": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "per-100g",
                      "per-100ml",
                      "per-serving",
                      "per-package",
                      "per-unit",
                      "other",
                      "unknown"
                    ]
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "g",
                          "ml",
                          "piece"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "amount",
                  "unit"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "key",
          "basis",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "fieldDiagnostics": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "basis": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "per-100g",
                      "per-100ml",
                      "per-serving",
                      "per-package",
                      "per-unit",
                      "other",
                      "unknown"
                    ]
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 10000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "g",
                          "ml",
                          "piece"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "amount",
                  "unit"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "parserRejectionCode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low-confidence",
                  "unparsed-format",
                  "unsupported-nutrient",
                  "missing-value",
                  "missing-unit",
                  "missing-basis",
                  "conflicting-candidates",
                  "invalid-number",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "basis",
          "parserRejectionCode"
        ],
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "object",
      "properties": {
        "coldStartMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "inferenceMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "warmRunCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "warmMedianMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "warmP95Ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "networkBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "imageTransferBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "modelBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "type": "object",
          "properties": {
            "valueBytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "browser-js-heap",
                "browser-process-rss",
                "wasm-linear-memory",
                "process-rss",
                "unavailable"
              ]
            },
            "measurement": {
              "type": "string",
              "enum": [
                "peak",
                "sample",
                "unavailable"
              ]
            }
          },
          "required": [
            "valueBytes",
            "scope",
            "measurement"
          ],
          "additionalProperties": false
        },
        "estimatedCostPer1000Images": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "costCurrency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "costAssumptions": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "costSourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "costAssumptionDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "coldStartMs",
        "inferenceMs",
        "warmRunCount",
        "warmMedianMs",
        "warmP95Ms",
        "networkBytes",
        "imageTransferBytes",
        "modelBytes",
        "memory",
        "estimatedCostPer1000Images",
        "costCurrency",
        "costAssumptions",
        "costSourceUrl",
        "costAssumptionDate"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "runtime": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "browser": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "operatingSystem": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "deviceClass": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "threadCount": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "networkProfile": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheState": {
          "type": "string",
          "enum": [
            "cold",
            "warm",
            "mixed",
            "unknown"
          ]
        },
        "powerProfile": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "thermalState": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runtime",
        "browser",
        "operatingSystem",
        "architecture",
        "cpu",
        "gpu",
        "deviceClass",
        "threadCount",
        "networkProfile",
        "cacheState",
        "powerProfile",
        "thermalState"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "input",
    "engine",
    "recognizedRegions",
    "candidates",
    "abstentions",
    "fieldDiagnostics",
    "measurements",
    "environment"
  ],
  "additionalProperties": false
}
