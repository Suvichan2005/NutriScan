{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutriscan:ocr-adjudication:1",
  "title": "NutriScan offline OCR annotation adjudication",
  "description": "Local decisions linking two independent single-reader passes to an explicitly adjudicated reference record. It contains no image bytes or local paths.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "adjudicatorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "adjudicatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "decisions": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "disposition": {
            "type": "string",
            "enum": [
              "reader-a",
              "reader-b",
              "manual",
              "ambiguous",
              "not-visible"
            ]
          },
          "readerAFieldId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "readerBFieldId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "field": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "fieldId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "labelText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "printedNumericText": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "numericValue": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "numericOperator": {
                    "default": "eq",
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "eq",
                          "lt",
                          "lte",
                          "gt",
                          "gte"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basis": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "per-100g",
                              "per-100ml",
                              "per-serving",
                              "per-package",
                              "per-unit",
                              "other",
                              "unknown"
                            ]
                          },
                          "amount": {
                            "anyOf": [
                              {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 10000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "unit": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "g",
                                  "ml",
                                  "piece"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "amount",
                          "unit"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basisText": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "labelRegionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "valueRegionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rowRegionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unitRegionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basisRegionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "columnId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "clear",
                      "ambiguous",
                      "not-visible"
                    ]
                  }
                },
                "required": [
                  "fieldId",
                  "key",
                  "labelText",
                  "numericValue",
                  "numericOperator",
                  "unit",
                  "basis",
                  "basisText",
                  "labelRegionId",
                  "valueRegionId",
                  "rowRegionId",
                  "unitRegionId",
                  "basisRegionId",
                  "columnId",
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "regionSource": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "reader-a",
                  "reader-b"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "fieldId",
          "disposition",
          "readerAFieldId",
          "readerBFieldId",
          "field",
          "regionSource",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasetVersion",
    "adjudicatorCode",
    "adjudicatedAt",
    "method",
    "decisions"
  ],
  "additionalProperties": false
}
