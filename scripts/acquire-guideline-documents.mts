import {readFile,mkdir,writeFile} from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const manifest=JSON.parse(await readFile('data/guideline-sources.json','utf8'));const dir=process.argv[2]??'.data/sources/who-guidelines';await mkdir(dir,{recursive:true});for(const source of manifest.sources){const file=path.join(dir,source.filename);try{const existing=await readFile(file);if(createHash('sha256').update(existing).digest('hex')!==source.sha256)throw Error('Existing source differs; preserved');console.log({id:source.id,status:'verified_existing'});continue;}catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;}const url=new URL(source.downloadUrl);if(url.protocol!=='https:'||url.hostname!=='iris.who.int'||!/^\/server\/api\/core\/bitstreams\/[a-f0-9-]+\/content$/.test(url.pathname))throw Error('Unexpected source URL');const r=await fetch(url,{redirect:'error',signal:AbortSignal.timeout(25000)});if(!r.ok||!r.body)throw Error(`Source unavailable ${source.id}`);const chunks:Uint8Array[]=[];let size=0;const reader=r.body.getReader();try{while(true){const {done,value}=await reader.read();if(done)break;size+=value.length;if(size>3000000)throw Error('Source over bounded size');chunks.push(value);}}finally{await reader.cancel().catch(()=>{});}const bytes=Buffer.concat(chunks);if(bytes.subarray(0,5).toString()!=='%PDF-'||createHash('sha256').update(bytes).digest('hex')!==source.sha256)throw Error('Source hash/type changed; no overwrite');await writeFile(file,bytes,{flag:'wx',mode:0o600});console.log({id:source.id,status:'acquired',bytes:size});}
