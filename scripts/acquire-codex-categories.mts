import {mkdir,writeFile,readFile} from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
// One fixed public HTML document; no image, API credential or user context.
const url='https://codex.fao.org/codex-texts/codex-online-databases/gsfa/food-categories';const dir=process.argv[2]??'.data/sources/codex';const response=await fetch(url,{redirect:'error',signal:AbortSignal.timeout(20000),headers:{'User-Agent':'NutriScan-LocalResearch/0.1 (research; no endorsement)'}});if(!response.ok||!response.headers.get('content-type')?.includes('text/html'))throw Error('Codex hierarchy unavailable');const reader=response.body?.getReader();if(!reader)throw Error('Empty source response');const chunks:Uint8Array[]=[];let size=0;try{while(true){const {done,value}=await reader.read();if(done)break;size+=value.length;if(size>1500000)throw Error('Source exceeds bounded hierarchy download');chunks.push(value);}}finally{await reader.cancel().catch(()=>{});}const data=Buffer.concat(chunks),hash=createHash('sha256').update(data).digest('hex'),date=new Date().toISOString();await mkdir(dir,{recursive:true});const file=path.join(dir,`categories-${date.slice(0,10)}-${hash.slice(0,12)}.html`);try{await writeFile(file,data,{flag:'wx',mode:0o600});}catch(error){if((error as NodeJS.ErrnoException).code!=='EEXIST')throw error;if(createHash('sha256').update(await readFile(file)).digest('hex')!==hash)throw Error('Existing source file differs; preserved without overwrite');}console.log(JSON.stringify({sourceUrl:url,file,bytes:size,sha256:hash,retrievedAt:date,rights:'FAO terms: research/non-commercial with attribution; no endorsement; commercial rights review required. Source excluded from Git.',importCommand:`python src/modules/knowledge/import_codex_categories.py --source-html "${file}" --output .data/knowledge/codex-categories.json --retrieved-at ${date.slice(0,10)}`},null,2));
